# LLM provider configuration. Default live workflow uses authenticated Codex CLI;
# AI_API_KEY/AI_BASE_URL are retained for compatibility but are not used by the workflow.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=codex-cli
# For local smoke testing without live LLM credentials, set AI_MODEL=offline-demo.

# Optional Slack delivery. Leave disabled/empty to only write daily_brief.md.
SLACK_ENABLED=true
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#industry-trends
SLACK_API_URL=https://slack.com/api/chat.postMessage

# Local runtime settings
DATABASE_PATH=data/intelligence.db
NEODYM_PROFILE_PATH=docs/neodym-profile.md
MAX_ITEMS_PER_SOURCE=10
BRIEF_LOOKBACK_HOURS=12
REQUEST_TIMEOUT_SECONDS=180
USER_AGENT=neodym-competitive-intelligence-agent/0.1
